# AutoPackager Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database
DB_PASSWORD=your_database_password_here

# Azure/Intune
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here

# Deployment Ring Group IDs (Entra ID)
RING0_GROUP_ID=it_pilot_group_id
RING1_GROUP_ID=early_adopters_group_id
RING2_GROUP_ID=broad_deployment_group_id
RING3_GROUP_ID=critical_systems_group_id

# LLM API Key
LLM_API_KEY=your_llm_api_key_here
