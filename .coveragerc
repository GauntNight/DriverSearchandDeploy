[run]
# Coverage configuration for AutoPackager
# Focus on core modules: agents, models, orchestration

omit =
    # Exclude test files within autopackager
    */tests/*
    */test_*.py
    # Exclude VM providers (external integration, not core business logic)
    */vm_providers/*
    */vm_validators.py
    # Exclude __pycache__ and .pyc files
    */__pycache__/*
    *.pyc

[report]
# Reporting options
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover
    # Don't complain about missing debug-only code
    def __repr__
    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError
    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    # Don't complain about abstract methods
    @abstractmethod

precision = 2
show_missing = True
